# Port server backend
PORT=4000

# Neon pooled connection string. Copy the complete value from Neon > Connect.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DATABASE?sslmode=require&channel_binding=require

# Generate a random secret of at least 32 characters. Keep this on the server only.
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
